scenario:
  id: free_fall_demo
  package: example-freefall-scenario

packages:
  - id: example-freefall-physics
    path: ../../packages/free-fall/body
  - id: example-freefall-gravity
    path: ../../packages/free-fall/gravity
  - id: example-freefall-objects
    path: ../../packages/free-fall/scene-objects

domains:
  - type: example-freefall-gravity/field
    factory: earth

entities:
  - id: ground
    type: example-freefall-objects/ground
    components:
      example-freefall-physics/position-2: { x: 0.0, y: 0.0 }
      example-freefall-physics/static-body: {}
      example-freefall-physics/collider: { restitution: 0.8 }

  - id: ball
    type: example-freefall-objects/ball
    components:
      example-freefall-physics/position-2: { x: 0.0, y: 10.0 }
      example-freefall-physics/velocity-2: { vx: 0.0, vy: 0.0 }

run:
  delta_time: 0.01
  max_time: 20.0

outputs:
  frames: runs/free_fall/frames.jsonl
  events: runs/free_fall/events.jsonl
  metrics: runs/free_fall/metrics.json
