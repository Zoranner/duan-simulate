scenario:
  id: naval_combat_demo
  package: examples-scenarios-naval-combat

packages:
  - id: examples-naval-combat-platform
    version: 0.1.0
  - id: examples-naval-combat-maneuver
    version: 0.1.0
  - id: examples-naval-combat-engagement
    version: 0.1.0
  - id: examples-naval-combat-fleet-objects
    version: 0.1.0

domains:
  - type: examples-naval-combat-maneuver/motion
  - type: examples-naval-combat-maneuver/collision
  - type: examples-naval-combat-engagement/combat

entities:
  - id: blue_01
    type: examples-naval-combat-fleet-objects/ship
    components:
      examples-naval-combat-platform/faction: { team: 0 }
      examples-naval-combat-maneuver/position-2: { x: 80.0, y: 120.0 }
      examples-naval-combat-maneuver/velocity-2: { vx: 18.0, vy: 0.0 }
      examples-naval-combat-platform/health: { current: 100.0, max: 100.0 }
      examples-naval-combat-platform/radar: { range: 260.0 }
      examples-naval-combat-engagement/weapon:
        range: 180.0
        damage: 25.0
        missile_speed: 80.0
        fire_cooldown: 1.5

  - id: red_01
    type: examples-naval-combat-fleet-objects/ship
    components:
      examples-naval-combat-platform/faction: { team: 1 }
      examples-naval-combat-maneuver/position-2: { x: 720.0, y: 360.0 }
      examples-naval-combat-maneuver/velocity-2: { vx: -16.0, vy: 0.0 }
      examples-naval-combat-platform/health: { current: 100.0, max: 100.0 }
      examples-naval-combat-platform/radar: { range: 260.0 }
      examples-naval-combat-engagement/weapon:
        range: 180.0
        damage: 25.0
        missile_speed: 80.0
        fire_cooldown: 1.5
